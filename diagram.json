    [ "buzzer:2",   "esp:GND.2",  "black",  [] ],
    [ "esp:6",      "motorIndicator:G", "yellow", [] ],
    [ "motorIndicator:COM", "esp:3V3", "yellow", [] ],
    [ "esp:10",     "rgb:R",      "red",    [] ],
    [ "rgb:COM",    "esp:3V3",    "red",    [] ],
    [ "powerSwitch:1", "esp:5V", "red", [] ],
    [ "powerSwitch:2", "esp:GND.1", "black", [] ]
