{
  "version": 1,
  "author": "RayelNabie",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-c3-devkitm-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": -80,
      "left": -160,
      "rotate": 90,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -80,
      "left": 160,
      "attrs": { "label": "Buzzer" }
    },
    {
      "type": "wokwi-rgb-led",
